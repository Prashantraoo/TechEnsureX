# NODE_ENV controls a real behavior change: in production, the server
# refuses to start unless JWT_SECRET is set to a real (non-default) value.
NODE_ENV=development

PORT=5000

# MongoDB connection string. Use a MongoDB Atlas URI in production — do
# not point production at a local mongod instance.
MONGODB_URI=mongodb://localhost:27017/techensurex

# Must be a strong, unique random value in production. The server will
# refuse to start in production without one.
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# The deployed frontend's origin, for CORS. Accepts a single URL or a
# comma-separated list (useful for a stable production URL plus one or
# more Vercel preview-deployment URLs), e.g.:
#   FRONTEND_URL=https://techensurex.vercel.app,https://techensurex-git-preview.vercel.app
FRONTEND_URL=http://localhost:8080

# NVIDIA NIM (Nemotron) — get a key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b
NIM_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NIM_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NIM_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety

# Cloudinary — required for medical report/document uploads. Get these
# from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
