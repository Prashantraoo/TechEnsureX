# ==========================================
# HealthGuard AI — Environment Variables
# ==========================================
# Copy this file to backend/.env and frontend/.env
# and fill in your actual values.

# --- Backend (.env) ---
# PORT=5000
# MONGODB_URI=mongodb://localhost:27017/healthguard
# JWT_SECRET=change-this-to-a-random-secret
# JWT_EXPIRES_IN=7d
# FRONTEND_URL=http://localhost:8080

# --- Frontend (.env) ---
# VITE_API_URL=http://localhost:5000/api
